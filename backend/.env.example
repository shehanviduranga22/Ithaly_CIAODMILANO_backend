# Copy to .env for local development. Set these in the backend Vercel project.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long
AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-bytes
FRONTEND_ORIGIN=https://ithaly-ciaodmilano-backend.vercel.app

# Local development only; Vercel provides its own port.
PORT=3001
